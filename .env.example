# OpenRouter (recommended free mode)
OPENROUTER_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free

# Optional fallback for OpenAI-compatible use
OPENAI_API_KEY=
OPENAI_MODEL=

SYSTEM_PROMPT=Ты Jarvis, полезный голосовой и текстовый ассистент. Отвечай по-русски, кратко и по делу.

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=

ALICE_WEBHOOK_TOKEN=

APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=/app/data/jarvis.db
MAX_HISTORY_MESSAGES=12
